{
  "vulnerability": "Broken Object Level Authorization (BOLA / IDOR)",
  "cases": [
    {
      "id": "idor-adjacent-next",
      "description": "Increment integer ID by 1 to access strictly adjacent objects",
      "payload": 1,
      "match_regex": "(?i)(api_key[\"\\s=:]+|secret_key[\"\\s=:]+|is_private[\"\\s=:]+true|confidential|role[\"\\s=:]+admin|password_hash)"
    },
    {
      "id": "idor-adjacent-prev",
      "description": "Decrement integer ID by 1 to access previous consecutive objects",
      "payload": -1,
      "match_regex": "(?i)(api_key[\"\\s=:]+|secret_key[\"\\s=:]+|is_private[\"\\s=:]+true|confidential|role[\"\\s=:]+admin|password_hash)"
    },
    {
