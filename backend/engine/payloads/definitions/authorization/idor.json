      "payload": -5,
      "match_regex": "(?i)(api_key[\"\\s=:]+|secret_key[\"\\s=:]+|is_private[\"\\s=:]+true|confidential|role[\"\\s=:]+admin|password_hash)"
    },
    {
      "id": "idor-far-boundary",
      "description": "Far boundary testing (+99) to extract potentially old or admin-reserved initial objects",
      "payload": 99,
      "match_regex": "(?i)(api_key[\"\\s=:]+|secret_key[\"\\s=:]+|is_private[\"\\s=:]+true|confidential|role[\"\\s=:]+admin|password_hash)"
