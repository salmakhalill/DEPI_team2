      "match_regex": "(?i)(api_key[\"\\s=:]+|secret_key[\"\\s=:]+|is_private[\"\\s=:]+true|confidential|role[\"\\s=:]+admin|password_hash)"
    },
    {
      "id": "idor-jump-medium",
